# =============================================================================
# Backend Medusa.js — Variáveis de Ambiente
# Copie para .env e ajuste os valores para seu ambiente.
# =============================================================================

# --- Banco de dados ---
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/BANCO?sslmode=disable
DATABASE_URL=postgres://medusa:senha_local@localhost:5432/medusa_dev?sslmode=disable

# --- Segurança (JWT e cookies) ---
# Gere valores seguros com: openssl rand -hex 32
JWT_SECRET=supersecret_troque_em_producao
COOKIE_SECRET=supersecret_troque_em_producao

# --- URLs de CORS ---
# Dev: deixe localhost. Prod: use os domínios reais separados por vírgula.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:3000
AUTH_CORS=http://localhost:9000,http://localhost:3000

# --- URLs do backend e da loja ---
BACKEND_URL=http://localhost:9000
STORE_URL=http://localhost:3000

# --- Storage de arquivos: MinIO / S3 ---
#
# DEV: MinIO local (docker-compose)
#   docker run -p 9001:9001 -p 9002:9000 -e MINIO_ROOT_USER=admin -e MINIO_ROOT_PASSWORD=password minio/minio server /data --console-address ":9001"
#   Crie o bucket: mc mb local/ecommerce-uploads && mc anonymous set download local/ecommerce-uploads
#
# PROD: MinIO no cluster K8s (configurado via k8s/secrets.yaml)
#
S3_URL=http://localhost:9002/ecommerce-uploads
S3_BUCKET=ecommerce-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9002
S3_ACCESS_KEY_ID=admin
S3_SECRET_ACCESS_KEY=password

# --- Redis (opcional, melhora performance) ---
# Se não definido, o sistema funciona sem cache Redis.
# REDIS_URL=redis://localhost:6379

# --- Pagamentos: ASAAS ---
# Obtenha em: https://www.asaas.com/
ASAAS_API_KEY=sua_chave_asaas
ASAAS_SANDBOX=true

# --- Email: Resend ---
# Obtenha em: https://resend.com/
RESEND_API_KEY=sua_chave_resend
RESEND_FROM_EMAIL=noreply@seudominio.com

# --- Integração MercadoLivre (marketplace) ---
ML_CLIENT_ID=seu_client_id
ML_CLIENT_SECRET=seu_client_secret
ML_REDIRECT_URI=http://localhost:9000/store/marketplace/oauth/callback/mercadolivre

# Chave de encriptação dos tokens de marketplace (pode usar o mesmo valor do JWT_SECRET)
MARKETPLACE_TOKEN_ENCRYPTION_KEY=supersecret_troque_em_producao

# --- Ambiente ---
NODE_ENV=development
PORT=9000
