# ============================================================================
# BACKEND - PRODUCTION ENVIRONMENT VARIABLES
# ============================================================================
# Copie este arquivo para .env.production no servidor e preencha os valores.
# Cada variavel tem instrucoes detalhadas de como obter.
# ============================================================================


# ===== DATABASE & REDIS =====

# DATABASE_URL: Conexao ao PostgreSQL
# No servidor K3s, o Postgres ja esta rodando internamente.
# Para uso LOCAL (desenvolvimento): DATABASE_URL=postgres://postgres:postgres@localhost:5433/medusa_ecommerce
# Para uso NO SERVIDOR (K3s): Configurado via k8s/secrets.yaml, nao precisa definir aqui.
# Se precisar definir manualmente:
DATABASE_URL=postgres://medusa:SENHA_DO_POSTGRES@HOST:5432/medusa_ecommerce?sslmode=disable

# REDIS_URL: Conexao ao Redis (usado para jobs e CSRF store do marketplace)
# Local: redis://localhost:6379
# Se nao tiver Redis, o marketplace usa fallback em memoria (nao recomendado para producao).
REDIS_URL=redis://localhost:6379


# ===== SEGURANCA =====

# JWT_SECRET: Segredo para assinatura de tokens JWT (sessoes de cliente/admin)
# Gere um valor aleatorio seguro. Rode no terminal: openssl rand -hex 32
JWT_SECRET=4d3fdb7ae44161daffd4bfc07af20de464473bfbd740a78259f46c8078dfaef6


# COOKIE_SECRET: Segredo para criptografia de cookies
# Gere um valor aleatorio seguro. Rode no terminal: openssl rand -hex 32
COOKIE_SECRET=4d3fdb7ae44161daffd4bfc07af20de464473bfbd740a78259f46c8078dfaef6



# ===== CORS (Origens permitidas) =====

# STORE_CORS: URLs do frontend que podem acessar a API da loja
# Em producao: https://shop.dozecrew.com
STORE_CORS=https://shop.dozecrew.com,http://localhost:3000

# ADMIN_CORS: URLs que podem acessar o painel admin
# Em producao: https://shop.dozecrew.com,https://shop-back.dozecrew.com
ADMIN_CORS=https://shop.dozecrew.com,https://shop-back.dozecrew.com,http://localhost:9000

# AUTH_CORS: URLs que podem acessar endpoints de autenticacao
# Mesmas origins do admin + frontend
AUTH_CORS=https://shop.dozecrew.com,https://shop-back.dozecrew.com,http://localhost:9000,http://localhost:3000


# ===== PAGAMENTOS - ASAAS (BRASIL) =====
# Asaas e o gateway de pagamentos (PIX, Boleto, Cartao de Credito).

# ASAAS_API_KEY: Chave da API do Asaas
# Como obter:
#   1. Para SANDBOX (testes):
#      a. Acesse https://sandbox.asaas.com e crie uma conta gratuita
#      b. Va em "Configuracoes" (engrenagem) > "Integracoes"
#      c. Copie a "API Key" que aparece la (comeca com "$aact_...")
#   2. Para PRODUCAO (dinheiro real):
#      a. Acesse https://www.asaas.com e faca login na sua conta real
#      b. Va em "Configuracoes" > "Integracoes"
#      c. Copie a API Key de producao
#      d. IMPORTANTE: Antes de ir para producao, mude ASAAS_SANDBOX para false
ASAAS_API_KEY=$aact_prod_000MzkwODA2MWY2OGM3MWRlMDU2NWM3MzJlNzZmNGZhZGY6Ojc4NzUyMjU0LWRiYjgtNDZjYi1hYzJmLTk5Y2U0YjVkYTk5Mjo6JGFhY2hfNWRiYmY0NTktYTFiYy00ODE4LWFlYjAtZWU1MGUzNjJiZjQ3

# ASAAS_SANDBOX: true = ambiente de testes, false = producao (dinheiro real)
# Comece com true para testar. Mude para false quando tiver a chave de producao.
ASAAS_SANDBOX=true

# URLs do Asaas (nao precisa mudar, ja estao corretas)
ASAAS_SANDBOX_URL=https://sandbox.asaas.com/api/v3
ASAAS_PRODUCTION_URL=https://api.asaas.com/api/v3


# ===== EMAILS TRANSACIONAIS - RESEND =====
# Resend e o servico de envio de emails (confirmacao de pedido, etc.)

# RESEND_API_KEY: Chave da API do Resend
# Como obter:
#   1. Acesse https://resend.com e crie uma conta gratuita
#   2. Clique em "API Keys" no menu lateral esquerdo
#   3. Clique em "Create API Key"
#   4. Escolha o nome (ex: "ecommerce") e clique em "Create"
#   5. Copie a chave gerada (comeca com "re_...")
#   6. Para producao, va em "Domains" e verifique o dominio do email (DNS TXT record)
RESEND_API_KEY=re_Rushkj9s_EPQxMVoZRcN4jxDYZoH2n5uA

# RESEND_FROM_EMAIL: Email que aparece como remetente das mensagens
# Deve ser um email verificado no Resend (em "Domains" > verifique o dominio)
RESEND_FROM_EMAIL=noreply@sualoja.com.br


# ===== MARKETPLACE - CRIPTOGRAFIA DE TOKENS =====

# MARKETPLACE_TOKEN_ENCRYPTION_KEY: Chave AES-256 para criptografar tokens de marketplace
# Gere um valor de 64 caracteres hexadecimais. Rode: openssl rand -hex 32
MARKETPLACE_TOKEN_ENCRYPTION_KEY=4d3fdb7ae44161daffd4bfc07af20de464473bfbd740a78259f46c8078dfaef6



# ===== MARKETPLACE - MERCADO LIVRE (OPCIONAL) =====
# So preencha se quiser conectar ao Mercado Livre.

# ML_CLIENT_ID: ID do aplicativo no Mercado Livre
# Como obter:
#   1. Acesse https://applications.mercadolibre.com.br/
#   2. Clique em "Crear nueva aplicacion"
#   3. Preencha: Nome (ex: "E-commerce Doze Crew"), Tipo "Gestion de venta"
#   4. Em "Redirect URI", coloque:
#      https://shop-back.dozecrew.com/store/marketplace/oauth/callback/mercadolivre
#   5. Apos criar, copie o "Client ID" da pagina do app
ML_CLIENT_ID=1465478461480690

# ML_CLIENT_SECRET: Segredo do aplicativo no Mercado Livre
#   1. Na mesma pagina do app (passo 4 acima), copie o "Client Secret"
ML_CLIENT_SECRET=2dGsjjGxGAPnUnXvQXOqs1uyx7S21PUj

# ML_REDIRECT_URI: URL de callback (deixe automatico, nao precisa mudar)
ML_REDIRECT_URI=https://shop-back.dozecrew.com/store/marketplace/oauth/callback/mercadolivre


# ===== MARKETPLACE - SHOPEE (OPCIONAL) =====
# So preencha se quiser conectar a Shopee.

# SHOPEE_PARTNER_ID: ID de parceiro da Shopee Open Platform
# Como obter:
#   1. Acesse https://open.shopee.com/ e faca login como vendedor
#   2. Vá em "App Management" > "Create App"
#   3. Preencha os dados do app (nome, descricao)
#   4. Em "Redirect URL", coloque:
#      https://shop-back.dozecrew.com/store/marketplace/oauth/callback/shopee
#   5. Apos aprovacao, copie o "Partner ID"
SHOPEE_PARTNER_ID=

# SHOPEE_PARTNER_KEY: Chave de parceiro da Shopee
#   1. Na mesma pagina do app, copie o "Partner Key"
SHOPEE_PARTNER_KEY=

# SHOPEE_REDIRECT_URI: URL de callback (deixe automatico)
SHOPEE_REDIRECT_URI=https://shop-back.dozecrew.com/store/marketplace/oauth/callback/shopee


# ===== MARKETPLACE - TIKTOK SHOP (OPCIONAL) =====
# So preencha se quiser conectar ao TikTok Shop.

# TIKTOK_APP_KEY: Chave do app no TikTok Shop
# Como obter:
#   1. Acesse https://affiliate.tiktokglobalshop.com/ e entre no Seller Center
#   2. Vá em "Open Platform" > "My Apps" > "Create App"
#   3. Escolha o tipo "Shop Management"
#   4. Copie o "App Key" gerado
TIKTOK_APP_KEY=

# TIKTOK_APP_SECRET: Segredo do app no TikTok Shop
#   1. Na mesma pagina do app, copie o "App Secret"
TIKTOK_APP_SECRET=


# ===== MARKETPLACE - FACEBOOK/INSTAGRAM (OPCIONAL) =====
# So preencha se quiser conectar ao Facebook/Instagram Shopping.

# FACEBOOK_APP_ID: ID do app no Meta for Developers
# Como obter:
#   1. Acesse https://developers.facebook.com/ e faca login
#   2. Clique em "My Apps" > "Create App"
#   3. Escolha o tipo "Negocios" (Business)
#   4. Configure o "Facebook Login" com o Redirect URI:
#      https://shop-back.dozecrew.com/store/marketplace/oauth/callback/facebook
#   5. Copie o "App ID" da pagina do app
FACEBOOK_APP_ID=

# FACEBOOK_APP_SECRET: Segredo do app no Meta
#   1. No painel do app, vá em "Configurações" > "Basico"
#   2. Copie o "App Secret"
FACEBOOK_APP_SECRET=

# FACEBOOK_REDIRECT_URI: URL de callback (deixe automatico)
FACEBOOK_REDIRECT_URI=https://shop-back.dozecrew.com/store/marketplace/oauth/callback/facebook


# ===== SERVIDOR =====

NODE_ENV=production
PORT=9000


# ============================================================================
# FRONTEND (frontend/.env.production)
# ============================================================================

# SITE_NAME: Nome exibido no header da loja
SITE_NAME=Minha Loja

# MEDUSA_BACKEND_URL: URL interna do backend (usada pelo servidor Next.js)
# Em K3s, o pod do frontend acessa o backend via servicename interno.
MEDUSA_BACKEND_URL=http://medusa-backend

# NEXT_PUBLIC_MEDUSA_BACKEND_URL: URL publica do backend (usada pelo browser)
# Deve ser o dominio HTTPS acessivel publicamente.
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://shop-back.dozecrew.com

# MEDUSA_PUBLISHABLE_KEY: Chave publica do Medusa (gerada automaticamente).
# Nao precisa preencher manualmente — o deploy.sh extrai do backend.

# MEDUSA_REVALIDATION_SECRET: Segredo para revalidacao ISR (cache de paginas)
# Deve ser o mesmo valor definido no webhook de revalidacao do Medusa.
MEDUSA_REVALIDATION_SECRET=ecommerce_jwt_secret_2026

# NODE_ENV: Ambiente de execucao
NODE_ENV=production


# ============================================================================
# RESUMO RAPIDO - ONDE OBTER CADA CREDENCIAL
# ============================================================================
# 1. ASAAS_API_KEY   → https://sandbox.asaas.com (teste) ou asaas.com (prod)
#                       > Configuracoes > Integracoes > Copiar API Key
# 2. RESEND_API_KEY  → https://resend.com
#                       > API Keys > Create API Key
# 3. JWT_SECRET      → Rode: openssl rand -hex 32
# 4. COOKIE_SECRET   → Rode: openssl rand -hex 32
# 5. MARKETPLACE...  → Rode: openssl rand -hex 32
#
# Opcionais (marketplace):
# 6. ML_*            → https://applications.mercadolibre.com.br
# 7. SHOPEE_*        → https://open.shopee.com/
# 8. TIKTOK_*        → https://affiliate.tiktokglobalshop.com/
# 9. FACEBOOK_*      → https://developers.facebook.com/
# ============================================================================
